# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit the real .env file — it is listed in .gitignore.

# ── MySQL warehouse ────────────────────────────────────────────────────────
# Every variable below without a value is REQUIRED; there are no default passwords.
MYSQL_ROOT_PASSWORD=changeme

# REQUIRED (no built-in defaults; docker compose refuses to start without them).
# Use URL-safe characters (letters and digits): POSTGRES_PASSWORD is placed inside a URL.
# Password for the `weather` pipeline account (SELECT/INSERT/UPDATE/DELETE on `weather`).
# On an EXISTING warehouse volume this must equal the password it was created with.
MYSQL_PASSWORD=
# Airflow metadata database. On an EXISTING postgres volume this must equal the old password.
POSTGRES_PASSWORD=
# Signs Airflow API tokens; any long random string (e.g. `openssl rand -hex 32`).
AIRFLOW__API_AUTH__JWT_SECRET=

# Host port mapped to container port 3306 (default 3307 to prevent collision with local MySQL)
WAREHOUSE_HOST_PORT=3307

# Use 127.0.0.1, not localhost: the published ports are IPv4-loopback only, and on Windows
# `localhost` tries ::1 first, adding ~2 s to every connection.
# Host-side test runner configuration (connects to host port, isolated test database)
TEST_WAREHOUSE_HOST=127.0.0.1
TEST_WAREHOUSE_PORT=3307
TEST_WAREHOUSE_DB=weather_test
TEST_WAREHOUSE_USER=weather
TEST_WAREHOUSE_PASSWORD=weather

# Airflow container environment uses internal Docker network defaults (warehouse:3306, weather)
# These host-side variables are only needed for direct host connection:
WAREHOUSE_HOST=127.0.0.1
WAREHOUSE_PORT=3307
WAREHOUSE_USER=weather
WAREHOUSE_PASSWORD=weather
WAREHOUSE_DB=weather
GEMINI_API_KEY=
# Model names (see https://ai.google.dev/gemini-api/docs/models). Examples:
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Ask SkySnap reader account and limits (defaults shown)
# READER_HOST=127.0.0.1
# READER_PORT=3307
# READER_USER=skysnap_reader
# READER_DB=weather
# MAX_ROWS=200
# QUERY_TIMEOUT_MS=5000
# TOP_K=4
# ANSWER_ROW_LIMIT=50
# INDEX_CACHE_PATH=.cache/ask_index.json

# Password for the read-only skysnap_reader account (created by sql/02-reader-user.sh)
SKYSNAP_READER_PASSWORD=
# Root password used only by the reader-account tests (set to MYSQL_ROOT_PASSWORD from .env)
TEST_MYSQL_ROOT_PASSWORD=
