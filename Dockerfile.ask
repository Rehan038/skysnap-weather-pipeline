FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt requirements-ask.txt ./
RUN pip install --no-cache-dir -r requirements-ask.txt

COPY src/ src/
COPY app/ app/
ENV PYTHONPATH=/app/src

EXPOSE 8501
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
